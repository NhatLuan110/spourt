# Copy to .env and adjust. Both apps read this single file.

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Local development uses the embedded PostgreSQL started by `pnpm pg:start`.
# With Docker available instead, use: postgresql://sprout:sprout@localhost:5432/sprout
DATABASE_URL="postgresql://sprout:sprout@127.0.0.1:5433/sprout"

WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# On Vercel, set NEXT_PUBLIC_API_URL=/api/v1 and API_ORIGIN to the Render origin.
# API_ORIGIN=https://your-sprout-api.onrender.com
COOKIE_SECRET=change-me-to-a-long-random-string

# Leave unset in development: an RS256 key pair is generated into apps/api/.keys
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Google sign-in (optional; email + password works without it)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Redis is optional in development; jobs and caching fall back to in-process.
# REDIS_URL=redis://localhost:6379

# AI (§10). Without a key the tutor and writing grader report "not configured"
# instead of failing silently.
#
# The provider is swappable (D-044). Gemini has a free tier that needs no card,
# which is why it is the default; switching to Claude later is one line here.
#   gemini     https://aistudio.google.com  -> Get API key
#   groq       https://console.groq.com
#   openrouter https://openrouter.ai        (models ending in :free)
#   ollama     https://ollama.com           (runs locally, no key at all)
#   anthropic  https://console.anthropic.com (paid)
AI_PROVIDER=gemini
# AI_API_KEY=

# Giọng nói chọn riêng, vì chỉ Gemini làm được miễn phí (D-053).
# Để chữ chạy ở Groq/GitHub mà vẫn giữ được chấm phát âm, đặt hai dòng này.
# Bỏ trống = dùng chung nhà cung cấp và khoá với phần chữ.
#   AI_SPEECH_PROVIDER=gemini | azure | none
# AI_SPEECH_PROVIDER=gemini
# AI_SPEECH_API_KEY=

# Model per provider. DEEP is used for writing feedback, FAST for the tutor.
# Verified against the free tier on 2026-09-05: the 2.5 line is closed to new
# keys, and the pro tier answers 429, so both roles run on 3.5 Flash. DEEP
# leaves thinking on for writing feedback; FAST turns it off for latency.
GEMINI_MODEL_DEEP=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.5-flash
# Audio, both confirmed working on the same free key (D-045).
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts
GEMINI_MODEL_STT=gemini-3.5-flash
GROQ_MODEL_DEEP=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
# GitHub Models: khoá là Personal Access Token của GitHub.
GITHUB_MODEL_DEEP=openai/gpt-4.1
GITHUB_MODEL_FAST=openai/gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEEP=qwen2.5:3b
OLLAMA_MODEL_FAST=qwen2.5:3b
ANTHROPIC_MODEL_DEEP=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-sonnet-5

# Speech (§9.3). Without Azure the fallback scorer in packages/scoring is used.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# Media storage: local writes to .storage and serves it from the API.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_PUBLIC_URL=http://localhost:4000/media
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# RESEND_API_KEY=
MAIL_FROM="Sprout <no-reply@sprout.local>"

RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=100
